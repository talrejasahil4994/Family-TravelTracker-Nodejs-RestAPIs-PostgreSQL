# Copy this file to .env and fill in the values, or set these in your hosting provider.
# If using a single connection string (recommended on Render/Railway/Neon/Heroku):
# DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:PORT/DBNAME

# Or specify individual parameters:
# PGHOST=localhost
# PGUSER=postgres
# PGDATABASE=world
# PGPASSWORD=your_password
# PGPORT=5432

# Set to "true" on providers that require SSL to connect (Render/Neon/etc.).
# PGSSL=true

# Optional: override the server port
# PORT=3000
